DB_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
# For Turso/libSQL, use:
# DATABASE_URL=libsql://<db-name>.<region>.turso.io
# DATABASE_AUTH_TOKEN=<token>
DATABASE_AUTH_TOKEN=
APP_PORT=4000
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
HOLD_MINUTES=7
LICENSE_SECRET=change-me-license-secret
COMMUNITY_BUILD=false
MP_PUBLIC_KEY=TEST-d05598fb-c3ce-42c1-af19-0cb1bf8f6e4e
MP_ACCESS_TOKEN=TEST-2311301713682112-021800-249fb393dbc95cb4cc8e8a5d00cc8fcf-291765832
APP_BASE_URL=http://localhost:5173
# IMPORTANT: Do not mix environments.
# TEST example:
# MP_PUBLIC_KEY=TEST-xxxxxxxx
# MP_ACCESS_TOKEN=TEST-xxxxxxxx
# LIVE example:
# MP_PUBLIC_KEY=APP_USR-xxxxxxxx
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
