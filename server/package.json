{
  "name": "clubpaddle-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev --name init",
    "prisma:pg:generate": "prisma generate --schema prisma/schema.postgresql.prisma",
    "prisma:pg:migrate": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "seed": "node prisma/seed.js",
    "test": "vitest run",
    "build": "node -e \"console.log('server build: no transpilation needed')\""
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^6.19.2",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rotating-file-stream": "^3.2.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
