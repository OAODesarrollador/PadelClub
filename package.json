{
  "name": "clubpaddle",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "cd client && npm run build && cd .. && node scripts/prepare-vercel-dist.mjs",
    "test": "npm run test -w server",
    "migrate:turso": "node scripts/migrate-sqlite-to-turso.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^6.3.1",
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.3.1"
  }
}