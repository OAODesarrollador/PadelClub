{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index"
    },
    {
      "source": "/api-docs/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/public/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/agenda",
      "destination": "/api/index"
    },
    {
      "source": "/admin/clubs",
      "destination": "/api/index"
    },
    {
      "source": "/admin/clubs/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/courts",
      "destination": "/api/index"
    },
    {
      "source": "/admin/courts/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/blocks",
      "destination": "/api/index"
    },
    {
      "source": "/admin/blocks/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/pricing",
      "destination": "/api/index"
    },
    {
      "source": "/admin/pricing/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/reservations",
      "destination": "/api/index"
    },
    {
      "source": "/admin/reservations/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/users",
      "destination": "/api/index"
    },
    {
      "source": "/admin/users/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/backups/create",
      "destination": "/api/index"
    },
    {
      "source": "/admin/backups/restore",
      "destination": "/api/index"
    },
    {
      "source": "/admin/backups/list",
      "destination": "/api/index"
    },
    {
      "source": "/admin/backups/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin/license/status",
      "destination": "/api/index"
    },
    {
      "source": "/admin/license/activate",
      "destination": "/api/index"
    },
    {
      "source": "/admin/license/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|public|health|api-docs|admin).*)",
      "destination": "/"
    }
  ]
}